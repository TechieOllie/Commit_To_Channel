# Source: "git" (default) or "nextcloud"
FILE_SOURCE=git

## Discord
DISCORD_TOKEN=your_bot_token_here
DISCORD_CHANNEL_ID=123456789012345678

## Polling
POLL_INTERVAL=300
UPLOAD_DELAY=1.0

## Git source
GIT_REPO_URL=https://gitea.example.com/youruser/your-repo.git
GITEA_TOKEN=your_access_token_here
GIT_USERNAME=git
# Relative path from repo root to scan for .md files. Leave empty for whole repo.
WATCHED_DIRECTORY=

## Nextcloud source (WebDAV)
# NEXTCLOUD_URL=https://nextcloud.example.com
# NEXTCLOUD_USERNAME=your_username
# NEXTCLOUD_PASSWORD=your_app_password
# NEXTCLOUD_PATH=/path/to/obsidian/vault
# NEXTCLOUD_CACHE_DIR=/data/nextcloud_cache
